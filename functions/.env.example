# Firebase / LINE 設定範例
# 1. 複製成 .env 後，填入你的實際值
# 2. 這個檔案只作為範例，不要直接上傳到 GitHub

LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
FUNCTION_API_KEY=your_random_api_key

# Firebase Functions 部署時可使用:
# firebase functions:config:set line.channel_secret="..." line.channel_access_token="..." line.function_api_key="..."
