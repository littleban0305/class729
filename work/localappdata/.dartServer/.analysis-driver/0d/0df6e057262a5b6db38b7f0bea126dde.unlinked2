///     </tr>
///     <tr>
///       <td>Valid date string</td>
///       <td><em>YYYY</em><code>-</code><em>MM</em><code>-</code><em>DD</em></td>
///       <td><code>1887-12-01</code></td>
///     </tr>
///     <tr>
